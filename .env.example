# ============================================================
# IHIMS environment variables (copy to `.env` and fill in)
# IMPORTANT: Never commit the real `.env` file (it is gitignored).
# ============================================================

# Your Supabase project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Your Supabase publishable (anon/public) key.
# New projects: Project Settings -> API -> "Publishable key"
# Legacy name: VITE_SUPABASE_ANON_KEY (see src/supabaseClient.js)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: force demo OTP mode (shows the code on-screen instead of emailing).
# Set to "true"/"1" to enable, or leave unset/false for real email OTP.
# VITE_OTP_DEMO=true
