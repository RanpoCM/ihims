# Copy this file to `.env` and fill in your real values.
# IMPORTANT: Never commit your real `.env` file (it is gitignored).
# These are publishable/public values (safe to expose in the browser).

# Supabase project URL, e.g. https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (new style) or legacy anon key.
# The app falls back to VITE_SUPABASE_ANON_KEY if the publishable key is absent.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key (optional fallback)
VITE_SUPABASE_ANON_KEY=
